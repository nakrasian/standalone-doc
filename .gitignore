# macOS
.DS_Store

# dependencies (the project itself has none; build tooling may add dev-only ones later)
node_modules/

# Unpublished material: docs, experiments, samples, planning notes.
# See archive/README.md. Nothing in archive/ is referenced by the build.
archive/

# The probe lab and the working documents for AI-human sessions.
lab/
/HANDOFF.md
/WORKFLOW.md

# Playwright output
test-results/
playwright-report/
# Visual baselines are generated on the Linux CI runner and kept in its cache: a page
# screenshot is platform-specific (font rasterisation), so macOS images are not baselines.
test/browser/pagination-visual.spec.js-snapshots/

# Private planning notes at the repo root (never published)
/*.md
!/README.md
!/CONTRIBUTING.md
!/DEPS.md
!/CHANGELOG.md
/*.txt

# Editor swap files
*.swp
*.swo

# browser-test scratch fixtures
.test-tmp/
