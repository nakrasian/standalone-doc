{
  "name": "standalone-doc",
  "version": "0.11.1",
  "private": true,
  "description": "A self-saving, single-file HTML document editor with a declarative asset system.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "split": "node build.mjs split",
    "combine": "node build.mjs combine",
    "build": "node build.mjs build",
    "release": "node build.mjs release",
    "verify": "node build.mjs verify",
    "check": "node build.mjs check",
    "report": "node build.mjs report",
    "baseline": "node build.mjs report --baseline",
    "dev": "node build.mjs dev",
    "cdn:verify": "node build.mjs verify-cdn",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "catalog": "node build.mjs catalog",
    "export": "node tools/export.mjs",
    "reference": "node tools/reference.mjs",
    "shim": "node tools/shim.mjs",
    "demo": "node tools/demo.mjs",
    "demo:comments": "node tools/demo-comments.mjs"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@playwright/test": "^1.65.1",
    "pandoc-wasm": "^1.1.0"
  }
}
